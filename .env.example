# Database (Supabase PostgreSQL - pooler)
DB_HOST=aws-1-ap-northeast-2.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.eokzeftuxtaahmqpvida
DB_PASSWORD=your-db-password
DB_NAME=postgres
DB_SSL=true
DB_SCHEMA=pumpkin

# 개봉 시각 (ISO 8601). 비워두면 언제든 개봉 가능 = 테스트 모드
# 예: OPEN_AT=2026-10-31T20:00:00+09:00
OPEN_AT=

# 배포 시 true (https 전용 쿠키)
COOKIE_SECURE=false

# 구글 로그인 (Google Cloud 콘솔 → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 리다이렉트 URI 기준 주소. 배포: https://pumpkin.zzam.today
PUBLIC_ORIGIN=http://127.0.0.1:5173
# 세션 쿠키 서명 키. python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# true 면 바구니 만들기에 로그인 필수 (배포에서 true)
LOGIN_REQUIRED=false
